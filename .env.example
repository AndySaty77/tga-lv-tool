# Basis-URL der App (z. B. für Passwort-Reset-E-Mail-Link). Ohne Angabe: lokal localhost:3000, sonst window.origin.
# NEXT_PUBLIC_SITE_URL=https://ihre-domain.de

# Supabase (für Triggers + Scoring-Config)
NEXT_PUBLIC_SUPABASE_URL=https://dein-projekt.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=dein_anon_key

# OpenAI (optional, für LLM-Split, Nachtragsanalyse, Vortext, etc.)
OPENAI_API_KEY=sk-...

# Optional: anderes Modell (Standard: gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini

# Admin-Bereich (/admin, /api/admin/*): nur diese E-Mail-Adressen haben Zugriff (kommasepariert)
# ADMIN_EMAILS=admin@example.com,team@example.com

# Kontaktformular (Team / Individuelle Anfrage) – E-Mail-Versand mit Resend
RESEND_API_KEY=re_...
CONTACT_FORM_TO_EMAIL=empfaenger@example.com
# Optional: eigener Absender (sonst: onboarding@resend.dev für Tests)
# CONTACT_FORM_FROM_EMAIL=TGA LV Tool <kontakt@ihredomain.de>
